<mujoco model="planar_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="64" offheight="64"/>
  </visual>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.2 0.2 0.25 1"/>
    <body name="base" pos="0 0 0.08">
      <geom type="cylinder" size="0.04 0.04" rgba="0.3 0.3 0.35 1" mass="0.4"/>
      <camera name="base_cam" pos="0.6 -0.4 0.4" xyaxes="1 0.4 0 0 0.3 1"/>
      <body name="link1" pos="0 0 0.04">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-1.8 1.8" damping="0.4"/>
        <geom type="capsule" fromto="0 0 0 0.22 0 0" size="0.02" rgba="0.7 0.4 0.2 1" mass="0.35"/>
        <body name="link2" pos="0.22 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-2.0 2.0" damping="0.3"/>
          <geom type="capsule" fromto="0 0 0 0.18 0 0" size="0.018" rgba="0.6 0.5 0.2 1" mass="0.25"/>
          <body name="link3" pos="0.18 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-2.2 2.2" damping="0.2"/>
            <geom type="capsule" fromto="0 0 0 0.12 0 0" size="0.015" rgba="0.5 0.6 0.3 1" mass="0.15"/>
            <site name="ee" pos="0.12 0 0" size="0.012" rgba="0.1 0.8 0.2 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
  </contact>
  <actuator>
    <position name="act1" joint="joint1" kp="40" ctrlrange="-1.8 1.8" forcerange="-12 12"/>
    <position name="act2" joint="joint2" kp="30" ctrlrange="-2.0 2.0" forcerange="-8 8"/>
    <position name="act3" joint="joint3" kp="20" ctrlrange="-2.2 2.2" forcerange="-4 4"/>
  </actuator>
</mujoco>
